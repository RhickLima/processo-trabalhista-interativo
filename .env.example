# ============================================================
# Variaveis de ambiente — Processo Trabalhista Interativo (TRT 18°)
# PRD secao 39
#
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositorio.
# Em producao, as variaveis sao configuradas diretamente no servidor.
# ============================================================

# URL base do site em producao (obrigatoria)
# Usada para gerar sitemap.xml e OG images (PRD secao 36.2)
# Exemplo de producao: https://processo.trt18.jus.br
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# URL da instancia Matomo do TRT 18° (obrigatoria antes do Sprint 6)
# A instancia Matomo deve ser auto-hospedada na infraestrutura do TRT 18°
# Nunca usar servicos externos de analytics (PRD secao 37.1)
# Exemplo: https://matomo.trt18.jus.br
NEXT_PUBLIC_MATOMO_URL=

# ID do site no Matomo (obrigatorio antes do Sprint 6)
# Obtido no painel de administracao do Matomo apos registrar o site
NEXT_PUBLIC_MATOMO_SITE_ID=

# NODE_ENV e gerenciado automaticamente pelo Next.js
# Valores possiveis: development | production | test
# NODE_ENV=development
